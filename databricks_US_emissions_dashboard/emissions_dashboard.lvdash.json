{
  "datasets": [
    {
      "name": "594eaeb3",
      "displayName": "Global Carbon Emissions by Location Dataset",
      "queryLines": [
        "SELECT latitude, longitude, `GHG emissions mtons CO2e` AS emissions\r\n",
        "FROM emissions.default.emissions_data"
      ]
    },
    {
      "name": "e98a6e91",
      "displayName": "Counties by Per Capita Greenhouse Emissions",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       CAST(\r\n",
        "        REPLACE(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "        AS DOUBLE\r\n",
        "        ) / NULLIF(\r\n",
        "          CAST(\r\n",
        "            REPLACE(`population`, ',', '')\r\n",
        "            AS DOUBLE\r\n",
        "            ), 0\r\n",
        "          ) AS emissions_per_person\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "ORDER BY emissions_per_person DESC"
      ]
    },
    {
      "name": "2855a24b",
      "displayName": "Statewise GHG Emissions Summary Report",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "       SUM(\r\n",
        "        CAST(\r\n",
        "          REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE\r\n",
        "          )\r\n",
        "        ) AS total_emissions\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY total_emissions DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "e999b6d8",
      "displayName": "Top Ten Counties by Carbon Emission Levels and Population Stats",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       CAST(\r\n",
        "        REPLACE(`GHG emissions mtons CO2e`, ',', '')\r\n",
        "        AS DOUBLE\r\n",
        "        ) AS total_emissions\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "ORDER BY total_emissions DESC\r\n",
        "LIMIT 10"
      ]
    }
  ],
